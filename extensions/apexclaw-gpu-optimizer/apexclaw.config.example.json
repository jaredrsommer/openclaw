{
  "$schema": "openclaw-config",
  "_comment_1": "ApexClaw config for GTX 1070 Ti fleet + Claude Max + Grok + NVIDIA NIM",
  "_comment_2": "Supports 1-4 nodes. Start with 2 and add more later — the system auto-adapts.",

  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434/v1",
        "api": "ollama",
        "apiKey": "OLLAMA_API_KEY",
        "models": [
          {
            "id": "qwen2.5:3b-instruct-q5_K_M",
            "name": "Qwen 2.5 3B Fast",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 32768,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "qwen2.5:7b-instruct-q4_K_M",
            "name": "Qwen 2.5 7B General",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 32768,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "qwen2.5-coder:7b-instruct-q4_K_M",
            "name": "Qwen 2.5 Coder 7B",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 32768,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "deepseek-r1:7b-q4_K_M",
            "name": "DeepSeek R1 7B Reasoning",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 16384,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      },

      "vllm": {
        "baseUrl": "http://127.0.0.1:8000/v1",
        "api": "openai-completions",
        "apiKey": "VLLM_API_KEY",
        "models": [
          {
            "id": "custom-qwen3-moe-trading",
            "name": "Custom Qwen3 MoE (Trading)",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 8192,
            "maxTokens": 4096,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      },

      "nvidia": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "api": "openai-completions",
        "apiKey": "NVIDIA_API_KEY",
        "models": [
          {
            "id": "nvidia/llama-3.1-nemotron-70b-instruct",
            "name": "NVIDIA Nemotron 70B (Free)",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 4096,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "nvidia/mistral-nemo-minitron-8b-8k-instruct",
            "name": "NVIDIA Minitron 8B Fast (Free)",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 8192,
            "maxTokens": 2048,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "meta/llama-3.3-70b-instruct",
            "name": "Llama 3.3 70B (Free via NVIDIA)",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 4096,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      },

      "xai": {
        "baseUrl": "https://api.x.ai/v1",
        "api": "openai-completions",
        "apiKey": "XAI_API_KEY",
        "models": [
          {
            "id": "grok-2",
            "name": "Grok 2",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 4096,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "grok-3",
            "name": "Grok 3 (Reasoning)",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 8192,
            "cost": { "input": 0.003, "output": 0.015, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      }
    }
  },

  "plugins": {
    "apexclaw-gpu-optimizer": {
      "gpuVramMb": 8192,
      "tradingMode": true,
      "maxLocalConcurrency": 1,
      "tier": "auto",
      "dashboardPort": 3939,

      "_comment_configs": "Pick ONE of the fleetNodes configs below based on how many machines you have:",

      "_2node_config_comment": "=== 2-NODE STARTER (Sentinel+Strategist on node1, Queen+Coder on node2) ===",
      "fleetNodes": [
        {
          "id": "node-1-sentinel",
          "name": "Sentinel+Strategist",
          "host": "192.168.1.101",
          "ollamaPort": 11434,
          "vllmPort": 8000,
          "gpuVramMb": 8192,
          "role": "sentinel",
          "hasCustomQwen": true,
          "maxConcurrency": 2,
          "assignedAgents": ["stream-observer", "signal-classifier", "liquidation-detector", "sentiment-analyzer", "anomaly-hunter"],
          "isDashboardHost": false
        },
        {
          "id": "node-2-queen",
          "name": "Queen+Coder",
          "host": "192.168.1.102",
          "ollamaPort": 11434,
          "vllmPort": 8000,
          "gpuVramMb": 8192,
          "role": "queen",
          "hasCustomQwen": false,
          "maxConcurrency": 1,
          "assignedAgents": ["risk-manager", "polymarket-analyst", "rbi-researcher", "rbi-backtester", "rbi-implementer"],
          "isDashboardHost": true
        }
      ],

      "_4node_config_comment": "=== 4-NODE FULL (copy this over fleetNodes when you have all machines) ===",
      "_4node_fleetNodes": [
        {
          "id": "node-1-sentinel",

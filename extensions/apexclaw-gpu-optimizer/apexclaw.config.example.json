{
  "$schema": "openclaw-config",
  "_comment_1": "ApexClaw config for GTX 1070 Ti fleet + Claude Max + Grok + NVIDIA NIM",
  "_comment_2": "Start with 1-2 nodes. Add machines later — just update fleetNodes and restart.",
  "_comment_3": "The MoE machine (128GB DDR4, Ryzen 5900X) is always the anchor node.",

  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434/v1",
        "api": "ollama",
        "apiKey": "OLLAMA_API_KEY",
        "_comment": "On the MoE machine, Ollama runs Qwen 3B on CPU (vLLM has the GPU). On other nodes, Ollama uses the GPU.",
        "models": [
          {
            "id": "qwen2.5:3b-instruct-q5_K_M",
            "name": "Qwen 2.5 3B Fast",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 32768,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "qwen2.5:7b-instruct-q4_K_M",
            "name": "Qwen 2.5 7B General",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 32768,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "qwen2.5-coder:7b-instruct-q4_K_M",
            "name": "Qwen 2.5 Coder 7B",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 32768,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "deepseek-r1:7b-q4_K_M",
            "name": "DeepSeek R1 7B Reasoning",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 16384,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      },

      "vllm": {
        "baseUrl": "http://127.0.0.1:8000/v1",
        "api": "openai-completions",
        "apiKey": "VLLM_API_KEY",
        "_comment": "Custom Qwen3 MoE runs ONLY on the MoE machine via vLLM. Other nodes don't need this.",
        "models": [
          {
            "id": "custom-qwen3-moe-trading",
            "name": "Custom Qwen3 MoE (Trading)",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 8192,
            "maxTokens": 4096,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      },

      "nvidia": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "api": "openai-completions",
        "apiKey": "NVIDIA_API_KEY",
        "_comment": "Free tier. Handles: RBI research, RBI implement, polymarket, market summaries. No GPU needed.",
        "models": [
          {
            "id": "nvidia/llama-3.1-nemotron-70b-instruct",
            "name": "NVIDIA Nemotron 70B (Free)",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 4096,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "nvidia/mistral-nemo-minitron-8b-8k-instruct",
            "name": "NVIDIA Minitron 8B Fast (Free)",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 8192,
            "maxTokens": 2048,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "meta/llama-3.3-70b-instruct",
            "name": "Llama 3.3 70B (Free via NVIDIA)",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 4096,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      },

      "xai": {
        "baseUrl": "https://api.x.ai/v1",
        "api": "openai-completions",
        "apiKey": "XAI_API_KEY",
        "models": [
          {
            "id": "grok-2",
            "name": "Grok 2",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 4096,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "grok-3",
            "name": "Grok 3 (Reasoning)",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 8192,
            "cost": { "input": 0.003, "output": 0.015, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      }
    }
  },

  "plugins": {
    "apexclaw-gpu-optimizer": {
      "gpuVramMb": 8192,
      "tradingMode": true,
      "maxLocalConcurrency": 2,
      "tier": "auto",
      "dashboardPort": 3939,

      "_comment_howto": [
        "Pick ONE fleetNodes config below based on how many GPU machines you have.",
        "Copy the appropriate array into the 'fleetNodes' field.",
        "The MoE machine (128GB/5900X) is always node-1-moe.",
        "Change host IPs to match your LAN."
      ],

      "_comment_active": "=== 2-NODE STARTER (recommended) ===",
      "fleetNodes": [
        {
          "id": "node-1-moe",
          "name": "MoE (Strategist+Queen)",
          "host": "192.168.1.101",
          "ollamaPort": 11434,
          "vllmPort": 8000,
          "gpuVramMb": 8192,
          "role": "strategist",
          "hasCustomQwen": true,
          "maxConcurrency": 2,
          "_comment": "128GB DDR4, Ryzen 5900X. GPU=vLLM(MoE), CPU=Ollama(3B). Backtesting runs here.",
          "assignedAgents": [
            "sentiment-analyzer", "anomaly-hunter",
            "stream-observer", "signal-classifier", "liquidation-detector",
            "rbi-backtester",
            "risk-manager", "polymarket-analyst"
